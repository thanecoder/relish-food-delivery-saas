# Copy this file to .env and fill in real values. .env is gitignored - never commit it.

# --- Database ---
DB_NAME=relish
DB_USER=relish
DB_PASSWORD=change-me-to-a-real-local-password

# --- Backend auth ---
# Generate a real random secret, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
CORS_ALLOWED_ORIGIN=http://localhost:4201

# --- Email (OTP delivery) ---
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=change-me
MAIL_PASSWORD=change-me
# When true, the backend also logs the OTP code to stdout - a dev/demo convenience
# so a presenter isn't blocked on real email delivery.
OTP_LOG_TO_CONSOLE=true
