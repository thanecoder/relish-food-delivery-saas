# Copy this file to .env and fill in real values. .env is git-ignored — never commit it.

# --- Database ---
DB_NAME=relish
DB_USER=relish
DB_PASSWORD=change-me
DB_HOST_PORT=5432

# --- Backend ---
BACKEND_HOST_PORT=8080
# Generate a real one with: docker run --rm alpine openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_A_REAL_RANDOM_BASE64_SECRET_AT_LEAST_32_BYTES
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
CORS_ALLOWED_ORIGIN=http://localhost:4200

# --- Email (OTP delivery) ---
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=change-me
MAIL_PASSWORD=change-me
# When true, the backend also logs the OTP code to stdout — a dev/demo convenience
# so a presenter isn't blocked on real email delivery. Off by default in prod.
OTP_LOG_TO_CONSOLE=true

# --- Frontend ---
FRONTEND_HOST_PORT=4200
